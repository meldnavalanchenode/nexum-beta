{
  "name": "nexum-beta",
  "version": "0.3.0",
  "description": "When your robot changes, Nexum tells you which of your previous testing no longer counts — and the minimum you must re-verify. FTC robots (config XML + Java TeamCode). Runs on your laptop, offline.",
  "type": "module",
  "bin": {
    "nexum": "bin/physync.js",
    "physync": "bin/physync.js"
  },
  "files": [
    "bin/",
    "src/",
    "samples/",
    "ui/",
    "README.md",
    "START_HERE.md"
  ],
  "scripts": {
    "check": "node bin/physync.js check --config samples/config.xml --code samples/TeamCode",
    "demo": "node bin/physync.js demo",
    "ui": "node src/server.js",
    "test": "node --test --test-concurrency=4 test/*.test.js",
    "prepack": "node -e \"const fs=require('node:fs');for(const f of ['README.md','START_HERE.md'])fs.copyFileSync('../'+f,f)\""
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.122.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "keywords": ["ftc", "robotics", "verification", "preflight", "first-tech-challenge"]
}
